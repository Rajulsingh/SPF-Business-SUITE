---
import AppLayout from "@/layouts/AppLayout.astro";
import { getDb } from "@/db/client";
import { formatDate, todayInputValue, startOfUtcDay } from "@/lib/format";
import { actions, isInputError } from "astro:actions";
import { eq } from "drizzle-orm";
import { flocks as flocksTable } from "@/db/schema";

export const prerender = false;

const db = getDb();

const activeFlocks = await db.query.flocks.findMany({
  where: eq(flocksTable.status, "ACTIVE"),
  orderBy: (f, { asc }) => [asc(f.name)],
  columns: { id: true, name: true },
});

const todayStart = startOfUtcDay();
const todayRecords = await db.query.dailyRecords.findMany({
  where: (r, { eq }) => eq(r.date, todayStart),
  with: { flock: { columns: { name: true } }, recordedBy: { columns: { name: true } } },
});

type TodayValues = {
  mortalityCount: number;
  mortalityCause: string;
  eggCount: string;
  gradeACount: string;
  gradeBCount: string;
  crackedCount: string;
  dirtyCount: string;
  feedConsumedKg: string;
  waterConsumedLiters: string;
  tempC: string;
  humidityPct: string;
  notes: string;
};

const todayByFlockId: Record<string, TodayValues> = {};
for (const r of todayRecords) {
  todayByFlockId[r.flockId] = {
    mortalityCount: r.mortalityCount,
    mortalityCause: r.mortalityCause ?? "",
    eggCount: r.eggCount?.toString() ?? "",
    gradeACount: r.gradeACount?.toString() ?? "",
    gradeBCount: r.gradeBCount?.toString() ?? "",
    crackedCount: r.crackedCount?.toString() ?? "",
    dirtyCount: r.dirtyCount?.toString() ?? "",
    feedConsumedKg: r.feedConsumedKg?.toString() ?? "",
    waterConsumedLiters: r.waterConsumedLiters?.toString() ?? "",
    tempC: r.tempC?.toString() ?? "",
    humidityPct: r.humidityPct?.toString() ?? "",
    notes: r.notes ?? "",
  };
}

const result = Astro.getActionResult(actions.dailyRecords.upsert);
const inputErrors = isInputError(result?.error) ? result.error.fields : {};
---

<AppLayout title="Daily log">
  <div class="space-y-6">
    <div>
      <h1 class="text-xl font-semibold" style="color: var(--color-ink)">Daily log</h1>
      <p class="text-sm" style="color: var(--color-ink-muted)">
        Quick entry for today's mortality, eggs, feed, water, and environment readings — the
        foundation everything else (uniformity tracking, alerting, trend charts) is built on.
        Logging the same flock again today updates that entry instead of duplicating it, and
        pre-fills with what's already saved.
      </p>
    </div>

    <div class="card p-4">
      {
        activeFlocks.length === 0 ? (
          <p class="rounded-md p-3 text-sm" style="background: var(--color-surface); color: var(--color-ink-secondary)">
            No active flocks yet. Add one on the Flocks page first.
          </p>
        ) : (
          <form method="POST" action={actions.dailyRecords.upsert} id="daily-log-form" class="space-y-4">
            <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
              <div>
                <label class="field-label" for="flockId">Flock</label>
                <select id="flockId" name="flockId" required class="field-input">
                  {activeFlocks.map((f) => (
                    <option value={f.id}>{f.name}</option>
                  ))}
                </select>
              </div>
              <div>
                <label class="field-label" for="date">Date</label>
                <input id="date" type="date" name="date" required value={todayInputValue()} class="field-input" />
              </div>
            </div>

            <p id="existing-entry-banner" class="hidden rounded-md p-2 text-sm" style="background: var(--color-warning-bg); color: var(--color-warning)">
              This flock already has an entry for today — the fields below are pre-filled with it.
              Saving will update that entry, not create a duplicate.
            </p>

            <p id="offline-banner" class="hidden rounded-md p-2 text-sm" style="background: var(--color-warning-bg); color: var(--color-warning)">
              You're offline. Keep going — what you type is saved on this device, and you can
              submit once you're back online.
            </p>

            <p id="draft-restored-banner" class="hidden rounded-md p-2 text-sm" style="background: var(--color-warning-bg); color: var(--color-warning)">
              Restored an entry that wasn't confirmed saved — maybe the connection dropped last
              time. Check it over before submitting.
              <button type="button" id="discard-draft-btn" class="underline">Discard it instead</button>
            </p>

            <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
              <div>
                <label class="field-label" for="mortalityCount">Mortality</label>
                <input id="mortalityCount" type="number" name="mortalityCount" min="0" value="0" class="field-input" />
              </div>
              <div>
                <label class="field-label" for="eggCount">Eggs collected</label>
                <input id="eggCount" type="number" name="eggCount" min="0" class="field-input" />
              </div>
              <div>
                <label class="field-label" for="feedConsumedKg">Feed (kg)</label>
                <input id="feedConsumedKg" type="number" name="feedConsumedKg" step="0.1" min="0" class="field-input" />
              </div>
              <div>
                <label class="field-label" for="waterConsumedLiters">Water (L)</label>
                <input id="waterConsumedLiters" type="number" name="waterConsumedLiters" step="0.1" min="0" class="field-input" />
              </div>
            </div>

            <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
              <div>
                <label class="field-label" for="tempC">Temp °C</label>
                <input id="tempC" type="number" name="tempC" step="0.1" class="field-input" />
              </div>
              <div>
                <label class="field-label" for="humidityPct">Humidity %</label>
                <input id="humidityPct" type="number" name="humidityPct" step="0.1" class="field-input" />
              </div>
              <div class="col-span-2">
                <label class="field-label" for="mortalityCause">Mortality cause (if any)</label>
                <input id="mortalityCause" name="mortalityCause" class="field-input" />
              </div>
            </div>

            <details class="rounded-md border p-3 text-sm" style="border-color: var(--color-border)">
              <summary class="cursor-pointer font-medium" style="color: var(--color-ink-secondary)">
                Egg grading breakdown (optional)
              </summary>
              <p class="mt-2 text-xs" style="color: var(--color-ink-muted)">
                Splits today's egg count by grade — a quality signal, not just a total. Leave
                blank if grading isn't done at collection time.
              </p>
              <div class="mt-3 grid grid-cols-2 gap-3 sm:grid-cols-4">
                <div>
                  <label class="field-label" for="gradeACount">Grade A</label>
                  <input id="gradeACount" type="number" name="gradeACount" min="0" class="field-input" />
                </div>
                <div>
                  <label class="field-label" for="gradeBCount">Grade B</label>
                  <input id="gradeBCount" type="number" name="gradeBCount" min="0" class="field-input" />
                </div>
                <div>
                  <label class="field-label" for="crackedCount">Cracked</label>
                  <input id="crackedCount" type="number" name="crackedCount" min="0" class="field-input" />
                </div>
                <div>
                  <label class="field-label" for="dirtyCount">Dirty</label>
                  <input id="dirtyCount" type="number" name="dirtyCount" min="0" class="field-input" />
                </div>
              </div>
            </details>

            <div>
              <label class="field-label" for="notes">Notes</label>
              <textarea id="notes" name="notes" rows="2" class="field-input" />
            </div>

            {result?.error && (
              <p class="banner-error">
                {isInputError(result.error)
                  ? Object.values(inputErrors).flat().join(" ")
                  : result.error.message}
              </p>
            )}
            {result && !result.error && <p class="banner-success">Saved.</p>}

            <button type="submit" class="btn-primary w-full sm:w-auto">Save today's entry</button>
          </form>
        )
      }
    </div>

    <div class="card overflow-hidden">
      <h2 class="border-b px-4 py-3 text-sm font-semibold" style="color: var(--color-ink); border-color: var(--color-border)">
        Logged today ({formatDate(todayStart)})
      </h2>
      <div class="overflow-x-auto">
        <table class="table-shell">
          <thead>
            <tr>
              <th>Flock</th>
              <th>Mortality</th>
              <th>Eggs</th>
              <th>Feed (kg)</th>
              <th>Logged by</th>
            </tr>
          </thead>
          <tbody>
            {
              todayRecords.map((r) => (
                <tr>
                  <td>{r.flock.name}</td>
                  <td>{r.mortalityCount}</td>
                  <td>{r.eggCount ?? "—"}</td>
                  <td>{r.feedConsumedKg ?? "—"}</td>
                  <td>{r.recordedBy?.name ?? "—"}</td>
                </tr>
              ))
            }
            {
              todayRecords.length === 0 && (
                <tr>
                  <td colspan="5" class="py-6 text-center" style="color: var(--color-ink-muted)">
                    No entries yet today.
                  </td>
                </tr>
              )
            }
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <script type="application/json" id="today-by-flock-data" set:html={JSON.stringify(todayByFlockId)} />
  <script>
    const data = JSON.parse(
      document.getElementById("today-by-flock-data")?.textContent ?? "{}"
    );

    const BLANK = {
      mortalityCount: 0,
      mortalityCause: "",
      eggCount: "",
      gradeACount: "",
      gradeBCount: "",
      crackedCount: "",
      dirtyCount: "",
      feedConsumedKg: "",
      waterConsumedLiters: "",
      tempC: "",
      humidityPct: "",
      notes: "",
    };

    const flockSelect = document.getElementById("flockId") as HTMLSelectElement | null;
    const dateInput = document.getElementById("date") as HTMLInputElement | null;
    const form = document.getElementById("daily-log-form") as HTMLFormElement | null;
    const banner = document.getElementById("existing-entry-banner");
    const offlineBanner = document.getElementById("offline-banner");
    const draftBanner = document.getElementById("draft-restored-banner");
    const discardDraftBtn = document.getElementById("discard-draft-btn");
    const fieldIds = [
      "mortalityCount",
      "eggCount",
      "gradeACount",
      "gradeBCount",
      "crackedCount",
      "dirtyCount",
      "feedConsumedKg",
      "waterConsumedLiters",
      "tempC",
      "humidityPct",
      "mortalityCause",
      "notes",
    ];

    function applyValues(flockId: string) {
      const values = data[flockId] ?? BLANK;
      for (const id of fieldIds) {
        const el = document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement | null;
        if (el) el.value = values[id] ?? "";
      }
      if (banner) banner.classList.toggle("hidden", !data[flockId]);
    }

    if (flockSelect) {
      applyValues(flockSelect.value);
      flockSelect.addEventListener("change", () => applyValues(flockSelect.value));
    }

    // Local draft recovery: this form is a plain POST (no JS required to
    // submit), but that means a dropped connection or an accidental tab
    // close mid-entry loses whatever was typed. We mirror the fields into
    // localStorage as the worker types, and offer it back if the page
    // reloads without a confirmed save.
    const DRAFT_KEY = "spf-daily-log-draft";

    type Draft = { flockId: string; date: string; values: Record<string, string> };

    function readDraft(): Draft | null {
      try {
        const raw = localStorage.getItem(DRAFT_KEY);
        return raw ? (JSON.parse(raw) as Draft) : null;
      } catch {
        return null;
      }
    }

    function writeDraft(draft: Draft) {
      try {
        localStorage.setItem(DRAFT_KEY, JSON.stringify(draft));
      } catch {
        // localStorage unavailable (private browsing, full quota) — draft
        // recovery just won't work; the plain POST still does.
      }
    }

    function clearDraft() {
      try {
        localStorage.removeItem(DRAFT_KEY);
      } catch {
        // ignore
      }
    }

    function currentFieldValues(): Record<string, string> {
      const values: Record<string, string> = {};
      for (const id of fieldIds) {
        const el = document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement | null;
        if (el) values[id] = el.value;
      }
      return values;
    }

    function saveDraftNow() {
      if (!flockSelect || !dateInput) return;
      writeDraft({ flockId: flockSelect.value, date: dateInput.value, values: currentFieldValues() });
    }

    const justSaved = document.querySelector(".banner-success") !== null;

    if (justSaved) {
      clearDraft();
    } else {
      const draft = readDraft();
      if (draft && flockSelect) {
        const flockStillExists = Array.from(flockSelect.options).some((o) => o.value === draft.flockId);
        if (flockStillExists) flockSelect.value = draft.flockId;
        if (dateInput && draft.date) dateInput.value = draft.date;
        applyValues(flockSelect.value);
        for (const id of fieldIds) {
          const el = document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement | null;
          if (el && draft.values[id] !== undefined) el.value = draft.values[id];
        }
        if (draftBanner) draftBanner.classList.remove("hidden");
      }
    }

    let saveTimer: ReturnType<typeof setTimeout> | undefined;
    if (form) {
      form.addEventListener("input", () => {
        if (saveTimer) clearTimeout(saveTimer);
        saveTimer = setTimeout(saveDraftNow, 400);
      });
      form.addEventListener("submit", () => {
        if (saveTimer) clearTimeout(saveTimer);
        saveDraftNow();
      });
    }

    if (discardDraftBtn) {
      discardDraftBtn.addEventListener("click", () => {
        clearDraft();
        if (draftBanner) draftBanner.classList.add("hidden");
        if (flockSelect) applyValues(flockSelect.value);
      });
    }

    function updateOfflineBanner() {
      if (offlineBanner) offlineBanner.classList.toggle("hidden", navigator.onLine);
    }
    updateOfflineBanner();
    window.addEventListener("online", updateOfflineBanner);
    window.addEventListener("offline", updateOfflineBanner);
  </script>
</AppLayout>
