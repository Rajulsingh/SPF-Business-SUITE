---
// Server-rendered SVG trend chart — no client JS. Follows the dataviz skill's
// mark specs: 2px line, ~10% opacity area wash, hairline solid gridlines,
// no legend (single series), sparse axis labels.
interface Point {
  label: string;
  value: number;
}

interface Props {
  data: Point[];
  color: string;
  unit: string;
}

const { data, color, unit } = Astro.props;

const INK_MUTED = "#898781";
const GRID = "#e1e0d9";

const width = 600;
const height = 180;
const padLeft = 40;
const padRight = 8;
const padTop = 10;
const padBottom = 22;
const plotWidth = width - padLeft - padRight;
const plotHeight = height - padTop - padBottom;

function niceMax(max: number): number {
  if (max <= 0) return 4;
  const magnitude = 10 ** Math.floor(Math.log10(max));
  const residual = max / magnitude;
  let niceResidual: number;
  if (residual <= 1) niceResidual = 1;
  else if (residual <= 2) niceResidual = 2;
  else if (residual <= 5) niceResidual = 5;
  else niceResidual = 10;
  return niceResidual * magnitude;
}

const rawMax = Math.max(...data.map((d) => d.value), 0);
const yMax = niceMax(rawMax);
const tickCount = 4;
const yTicks = Array.from({ length: tickCount + 1 }, (_, i) => (yMax / tickCount) * i);

function xAt(i: number): number {
  if (data.length <= 1) return padLeft;
  return padLeft + (i / (data.length - 1)) * plotWidth;
}
function yAt(value: number): number {
  const ratio = yMax === 0 ? 0 : value / yMax;
  return padTop + plotHeight - ratio * plotHeight;
}

const linePoints = data.map((d, i) => `${xAt(i)},${yAt(d.value)}`).join(" ");
const areaPoints = `${padLeft},${padTop + plotHeight} ${linePoints} ${xAt(data.length - 1)},${padTop + plotHeight}`;

// Sparse x-axis labels: first, middle, last — matches "label selectively" from the mark specs.
const labelIndexes = data.length > 1 ? [0, Math.floor((data.length - 1) / 2), data.length - 1] : [0];
---

<svg viewBox={`0 0 ${width} ${height}`} class="w-full" role="img" aria-label={`Trend chart, ${unit} per day`}>
  {yTicks.map((tick) => (
    <line
      x1={padLeft}
      x2={width - padRight}
      y1={yAt(tick)}
      y2={yAt(tick)}
      stroke={GRID}
      stroke-width="1"
    />
  ))}
  {yTicks.map((tick) => (
    <text x={padLeft - 6} y={yAt(tick) + 3} text-anchor="end" font-size="10" fill={INK_MUTED}>
      {Math.round(tick).toLocaleString()}
    </text>
  ))}
  {labelIndexes.map((i) => (
    <text x={xAt(i)} y={height - 4} text-anchor={i === 0 ? "start" : i === data.length - 1 ? "end" : "middle"} font-size="10" fill={INK_MUTED}>
      {data[i]?.label}
    </text>
  ))}
  <polygon points={areaPoints} fill={color} fill-opacity="0.1" stroke="none" />
  <polyline points={linePoints} fill="none" stroke={color} stroke-width="2" stroke-linejoin="round" stroke-linecap="round" />
  {data.length > 0 && (
    <circle cx={xAt(data.length - 1)} cy={yAt(data[data.length - 1].value)} r="4" fill={color} stroke="#fcfcfb" stroke-width="2" />
  )}
</svg>
