DATABASE_URL="file:./dev.db"

# Secret used to sign session cookies. Generate your own for real deployments,
# e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
SESSION_SECRET="replace-with-a-long-random-string"

# Used only by `prisma db seed` to create the first login. Change the password
# after first login (no self-service change screen yet).
SEED_OWNER_NAME="Farm Owner"
SEED_OWNER_USERNAME="owner"
SEED_OWNER_PASSWORD="changeme123"
